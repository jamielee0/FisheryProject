# Data: never commit raw, interim, or processed data.
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Results and figures: reproducible outputs, not source files.
results/*
!results/.gitkeep
figures/*
!figures/.gitkeep

# Large geospatial and raster/vector files.
*.tif
*.tiff
*.img
*.ecw
*.vrt
*.asc
*.grd
*.shp
*.shx
*.dbf
*.prj
*.sbn
*.sbx
*.cpg
*.qpj
*.gpkg
*.fgb
*.geojsonl
*.gdb/

# Columnar and scientific binary outputs.
*.parquet
*.geoparquet
*.nc
*.nc4
*.cdf
*.h5
*.hdf5
*.zarr/

# Model artifacts and serialized objects.
*.pkl
*.pickle
*.joblib
*.pt
*.pth
*.onnx

# Credentials and local secrets.
.env
.env.*
*.key
*.pem
secrets.yaml
secrets.yml
credentials.yaml
credentials.yml
credentials.json
*_credentials.*
config/local_*.yaml
configs/local_*.yaml

# Python caches and build artifacts.
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.eggs/
dist/
build/
*.whl
MANIFEST

# Virtual environments.
.venv/
venv/
env/
ENV/
.conda/

# Jupyter.
.ipynb_checkpoints/
*.ipynb_checkpoints

# Testing, coverage, linting, and type checking.
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.tox/
.ruff_cache/
.mypy_cache/

# Editors and operating-system files.
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
*.code-workspace

# Logs.
*.log
logs/
mlruns/
